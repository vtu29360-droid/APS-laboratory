class Solution {
    public int[] getSumAbsoluteDifferences(int[] nums) {

        int n = nums.length;
        int[] result = new int[n];

        int sum = 0;

        // Find total sum
        for (int num : nums) {
            sum += num;
        }

        int leftSum = 0;

        for (int i = 0; i < n; i++) {

            int rightSum = sum - leftSum - nums[i];

            int leftCount = i;
            int rightCount = n - i - 1;

            int left = nums[i] * leftCount - leftSum;
            int right = rightSum - nums[i] * rightCount;

            result[i] = left + right;

            leftSum += nums[i];
        }

        return result;
    }
}
        
    
